  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MotionHighlighter\MotionHighlighter.csproj" />
  </ItemGroup>

</Project>
